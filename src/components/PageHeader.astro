---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  meta?: string;
}

const { eyebrow, title, description, meta } = Astro.props;
---

<section class="page-header">
  <div class="container page-header__inner">
    <p class="eyebrow eyebrow--blue">{eyebrow}</p>
    <h1>{title}</h1>
    <div class="page-header__support">
      <p class="page-header__description">{description}</p>
      {meta && <p class="page-header__meta">{meta}</p>}
    </div>
  </div>
</section>

<style>
  .page-header {
    padding-block: clamp(64px, 9vw, 104px) clamp(40px, 5vw, 56px);
    border-bottom: 1px solid var(--line);
    background: var(--bg);
  }

  .page-header__inner {
    display: grid;
    gap: 20px;
  }

  .page-header h1 {
    max-width: 16ch;
    font-size: clamp(42px, 6.4vw, 72px);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.045em;
  }

  .page-header__support {
    display: flex;
    gap: 24px 48px;
    align-items: flex-end;
    justify-content: space-between;
    padding-top: 12px;
  }

  .page-header__description {
    max-width: 58ch;
    color: var(--ink-secondary);
    font-size: clamp(17px, 1.6vw, 21px);
    line-height: 1.5;
  }

  .page-header__meta {
    flex: none;
    color: var(--ink-tertiary);
    font-size: 12px;
    line-height: 1.6;
  }

  @media (max-width: 734px) {
    .page-header {
      padding-block: 56px 36px;
    }

    .page-header h1 {
      font-size: clamp(38px, 11vw, 52px);
    }

    .page-header__support {
      align-items: flex-start;
      flex-direction: column;
      gap: 16px;
      padding-top: 4px;
    }

    .page-header__meta {
      font-size: 12px;
    }
  }
</style>
