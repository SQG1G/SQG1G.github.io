---
import type { PostEntry } from '../lib/content';
import { formatDate, getReadingTime, postHref } from '../lib/content';

interface Props {
  entry: PostEntry;
  featured?: boolean;
}

const { entry, featured = false } = Astro.props;
const href = postHref(entry);
const readingTime = getReadingTime(entry.body);
const visibleTags = entry.data.tags.slice(0, 3);
---

<article class:list={['post-card', { 'post-card--featured': featured }]}>
  <a class="post-card__link" href={href}>
    <div class="post-card__meta">
      <span>{featured ? '最新文章' : '文章'}</span>
      <span class="post-card__dot" aria-hidden="true"></span>
      <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
      <span class="post-card__dot" aria-hidden="true"></span>
      <span>{readingTime} 分钟阅读</span>
    </div>

    <div class="post-card__body">
      <h3>{entry.data.title}</h3>
      <p>{entry.data.description}</p>
    </div>

    <div class="post-card__footer">
      {visibleTags.length > 0 && (
        <ul class="tag-list" aria-label="标签">
          {visibleTags.map((tag) => (
            <li>
              <span class="tag">{tag}</span>
            </li>
          ))}
        </ul>
      )}
      <span class="post-card__cta">
        阅读全文 <span aria-hidden="true">›</span>
      </span>
    </div>
  </a>
</article>

<style>
  .post-card {
    height: 100%;
    border: 1px solid var(--post-card-border, transparent);
    border-radius: var(--radius);
    background: var(--post-card-bg, var(--bg-secondary));
    box-shadow: var(--post-card-shadow, none);
    transform: translateY(0);
    transition:
      background-color 220ms var(--ease),
      border-color 220ms var(--ease),
      box-shadow 260ms var(--ease),
      transform 260ms var(--ease);
    backdrop-filter: var(--post-card-blur, none);
    -webkit-backdrop-filter: var(--post-card-blur, none);
  }

  .post-card:hover {
    border-color: var(--post-card-border-hover, var(--post-card-border, transparent));
    background: var(--post-card-hover, #ececf0);
    box-shadow: var(--post-card-shadow-hover, var(--post-card-shadow, none));
    transform: translateY(-3px);
  }

  .post-card__link {
    display: flex;
    height: 100%;
    min-height: 320px;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(28px, 3vw, 36px);
    color: var(--ink);
    text-decoration: none;
  }

  .post-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    color: var(--ink-secondary);
    font-size: 12px;
    line-height: 1.4;
  }

  .post-card__dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--ink-tertiary);
  }

  .post-card__body {
    margin-block: 52px;
  }

  .post-card__body h3 {
    max-width: 24ch;
    color: var(--ink);
    font-size: clamp(24px, 2.4vw, 28px);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.03em;
  }

  .post-card__body p {
    max-width: 58ch;
    margin-top: 12px;
    color: var(--ink-secondary);
    font-size: 17px;
    line-height: 1.5;
  }

  .post-card__footer {
    display: flex;
    gap: 20px;
    align-items: flex-end;
    justify-content: space-between;
  }

  .post-card__cta {
    flex: none;
    color: var(--blue);
    font-size: 17px;
    line-height: 1.2;
    transition: color 160ms ease;
  }

  .post-card:hover .post-card__cta {
    color: var(--blue-hover);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-card--featured {
    background: var(--post-card-bg, var(--bg-secondary));
  }

  .post-card--featured .post-card__link {
    min-height: 420px;
    padding: clamp(36px, 6vw, 72px);
  }

  .post-card--featured .post-card__body {
    margin-block: 72px;
  }

  .post-card--featured .post-card__body h3 {
    max-width: 22ch;
    font-size: clamp(34px, 4.6vw, 56px);
    line-height: 1.06;
    letter-spacing: -0.038em;
  }

  .post-card--featured .post-card__body p {
    max-width: 52ch;
    font-size: 21px;
    line-height: 1.48;
  }

  @media (max-width: 734px) {
    .post-card__link {
      min-height: 280px;
      padding: 24px;
    }

    .post-card__body {
      margin-block: 40px;
    }

    .post-card__body h3 {
      font-size: 24px;
    }

    .post-card__body p {
      font-size: 15px;
    }

    .post-card--featured .post-card__link {
      min-height: 0;
      padding: 28px 24px;
    }

    .post-card--featured .post-card__body {
      margin-block: 48px;
    }

    .post-card--featured .post-card__body h3 {
      font-size: 36px;
    }

    .post-card--featured .post-card__body p {
      font-size: 17px;
    }

    .post-card__footer {
      align-items: flex-start;
      flex-direction: column;
      gap: 20px;
    }
  }
</style>
