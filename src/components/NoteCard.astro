---
import type { NoteEntry } from '../lib/content';
import { NOTE_STATUS, formatDate, getReadingTime, noteHref } from '../lib/content';

interface Props {
  entry: NoteEntry;
  dark?: boolean;
}

const { entry, dark = false } = Astro.props;
const href = noteHref(entry);
const readingTime = getReadingTime(entry.body);
const status = NOTE_STATUS[entry.data.status];
---

<article class:list={['note-card', { 'note-card--dark': dark }]}>
  <a class="note-card__link" href={href}>
    <div class="note-card__meta">
      <span class="note-card__status">
        <span
          class:list={['note-card__dot', `note-card__dot--${entry.data.status}`]}
          aria-hidden="true"
        ></span>
        {status.label}
      </span>
      <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
    </div>

    <div class="note-card__body">
      <h3>{entry.data.title}</h3>
      <p>{entry.data.description}</p>
    </div>

    <div class="note-card__footer">
      <span>{readingTime} 分钟阅读</span>
      <span class="note-card__cta">
        阅读 <span aria-hidden="true">›</span>
      </span>
    </div>
  </a>
</article>

<style>
  .note-card {
    height: 100%;
    border-radius: var(--radius);
    background: var(--bg-secondary);
    transition: background-color 200ms var(--ease);
  }

  .note-card:hover {
    background: #ececf0;
  }

  .note-card__link {
    display: flex;
    height: 100%;
    min-height: 300px;
    flex-direction: column;
    padding: clamp(24px, 2.8vw, 32px);
    color: var(--ink);
    text-decoration: none;
  }

  .note-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 12px;
    align-items: center;
    justify-content: space-between;
    color: var(--ink-secondary);
    font-size: 12px;
    line-height: 1.4;
  }

  .note-card__status {
    display: inline-flex;
    gap: 7px;
    align-items: center;
    color: var(--ink-secondary);
  }

  .note-card__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ink-tertiary);
  }

  .note-card__dot--seedling {
    background: var(--orange);
  }

  .note-card__dot--growing {
    background: var(--green);
  }

  .note-card__dot--evergreen {
    background: var(--blue);
  }

  .note-card__body {
    margin-block: auto;
    padding-block: 48px;
  }

  .note-card__body h3 {
    max-width: 20ch;
    color: var(--ink);
    font-size: clamp(22px, 2vw, 24px);
    font-weight: 600;
    line-height: 1.16;
    letter-spacing: -0.03em;
  }

  .note-card__body p {
    max-width: 40ch;
    margin-top: 12px;
    color: var(--ink-secondary);
    font-size: 15px;
    line-height: 1.55;
  }

  .note-card__footer {
    display: flex;
    gap: 16px;
    align-items: center;
    justify-content: space-between;
    color: var(--ink-secondary);
    font-size: 12px;
    line-height: 1.4;
  }

  .note-card__cta {
    color: var(--blue);
    font-size: 14px;
    transition: color 160ms ease;
  }

  .note-card:hover .note-card__cta {
    color: var(--blue-hover);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .note-card--dark {
    background: var(--dark-surface);
  }

  .note-card--dark:hover {
    background: var(--dark-surface-hover);
  }

  .note-card--dark .note-card__link,
  .note-card--dark .note-card__body h3 {
    color: var(--dark-text);
  }

  .note-card--dark .note-card__meta,
  .note-card--dark .note-card__status,
  .note-card--dark .note-card__body p,
  .note-card--dark .note-card__footer {
    color: var(--dark-secondary);
  }

  .note-card--dark .note-card__cta {
    color: var(--blue-on-dark);
  }

  .note-card--dark .tag {
    background: #2c2c2e;
    color: var(--dark-text);
  }

  @media (max-width: 734px) {
    .note-card__link {
      min-height: 240px;
      padding: 24px;
    }

    .note-card__body {
      padding-block: 36px;
    }

    .note-card__body h3 {
      font-size: 22px;
    }
  }
</style>
