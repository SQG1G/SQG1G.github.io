---
import { SITE } from '../config';

const year = new Date().getFullYear();
---

<footer class="global-footer">
  <div class="global-footer__inner">
    <div class="global-footer__grid">
      <section aria-labelledby="footer-explore">
        <h2 id="footer-explore" class="footer-heading">
          浏览
        </h2>
        <nav class="footer-links" aria-label="页脚导航">
          {SITE.nav.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </nav>
      </section>

      <section aria-labelledby="footer-follow">
        <h2 id="footer-follow" class="footer-heading">
          关注
        </h2>
        <div class="footer-links">
          <a href={SITE.github} target="_blank" rel="noreferrer">
            GitHub
          </a>
          <a href="/rss.xml" data-astro-reload>
            RSS
          </a>
          <a href={SITE.repo} target="_blank" rel="noreferrer">
            站点源码
          </a>
        </div>
      </section>

      <section class="footer-about" aria-labelledby="footer-about">
        <h2 id="footer-about" class="footer-heading">
          关于
        </h2>
        <p>一个关于代码、系统与日常的个人数字花园。慢慢写，认真想。</p>
      </section>
    </div>

    <div class="global-footer__meta">
      <p>
        Copyright © {year} {SITE.name}. All rights reserved.
      </p>
      <p>
        <a href="/">SQG1G</a>
        <span aria-hidden="true">·</span>
        Built with{' '}
        <a href="https://astro.build" target="_blank" rel="noreferrer">
          Astro
        </a>
        <span aria-hidden="true">·</span>
        Hosted on{' '}
        <a href="https://pages.github.com" target="_blank" rel="noreferrer">
          GitHub Pages
        </a>
      </p>
    </div>
  </div>
</footer>

<style>
  .global-footer {
    padding-block: 36px 22px;
    border-top: 1px solid var(--line);
    background: var(--bg-secondary);
    color: var(--ink-secondary);
    font-size: 12px;
    line-height: 1.5;
  }

  .global-footer__inner {
    width: min(100% - 44px, 1024px);
    margin-inline: auto;
  }

  .global-footer__grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1.2fr;
    gap: 48px;
    padding-bottom: 28px;
  }

  .footer-heading {
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.33;
  }

  .footer-links {
    display: grid;
    gap: 9px;
    margin-top: 12px;
  }

  .footer-links a,
  .global-footer__meta a {
    color: var(--ink-secondary);
    text-underline-offset: 2px;
  }

  .footer-links a:hover,
  .global-footer__meta a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .footer-about p {
    max-width: 34ch;
    margin-top: 12px;
    color: var(--ink-secondary);
    font-size: 12px;
    line-height: 1.55;
  }

  .global-footer__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    align-items: center;
    justify-content: space-between;
    padding-top: 18px;
    border-top: 1px solid var(--line);
  }

  .global-footer__meta span {
    margin-inline: 5px;
    color: var(--ink-tertiary);
  }

  @media (max-width: 734px) {
    .global-footer {
      padding-block: 28px 20px;
    }

    .global-footer__inner {
      width: min(100% - 32px, 1024px);
    }

    .global-footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: 28px 24px;
    }

    .footer-about {
      grid-column: 1 / -1;
    }

    .global-footer__meta {
      align-items: flex-start;
      flex-direction: column;
      gap: 6px;
    }
  }
</style>
