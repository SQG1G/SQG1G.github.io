---
---

<dialog class="search-dialog" data-search-dialog aria-labelledby="search-dialog-title">
  <div class="search-panel">
    <div class="search-top">
      <div class="search-heading">
        <p class="search-label">搜索</p>
        <h2 id="search-dialog-title">搜索 SQG1G</h2>
      </div>
      <button class="search-close" type="button" data-search-close aria-label="关闭搜索">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="m6 6 12 12M18 6 6 18"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
          ></path>
        </svg>
      </button>
    </div>

    <label class="search-field">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="10.8" cy="10.8" r="6.4" stroke="currentColor" stroke-width="1.5"></circle>
        <path
          d="m15.7 15.7 4.5 4.5"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
        ></path>
      </svg>
      <span class="visually-hidden">搜索文章和笔记</span>
      <input
        type="search"
        placeholder="搜索文章、笔记或标签"
        autocomplete="off"
        spellcheck="false"
        enterkeyhint="go"
        data-search-input
        aria-controls="search-results"
      />
      <span class="search-esc">ESC</span>
    </label>

    <div class="search-status" data-search-status aria-live="polite">
      输入关键词开始搜索。
    </div>

    <ul id="search-results" class="search-results" data-search-results aria-label="搜索结果"></ul>

    <div class="search-empty" data-search-empty hidden>
      <p>没有找到相关内容。</p>
      <span>
        换一个词试试，或者去<a href="/posts/">文章列表</a>浏览。
      </span>
    </div>

    <div class="search-foot">
      <span>
        <kbd>↑</kbd>
        <kbd>↓</kbd> 选择
      </span>
      <span>
        <kbd>↵</kbd> 打开
      </span>
      <span class="search-foot__aside">搜索索引在构建时生成</span>
    </div>
  </div>
</dialog>

<style>
  .search-dialog {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    padding: 0;
    border: 0;
    border-radius: 0;
    margin: 0;
    background: transparent;
    color: var(--ink);
    overflow: hidden;
  }

  .search-dialog::backdrop {
    background: rgba(0, 0, 0, 0.32);
    backdrop-filter: blur(18px) saturate(130%);
    -webkit-backdrop-filter: blur(18px) saturate(130%);
  }

  .search-dialog[open] {
    animation: search-in 220ms var(--ease) both;
  }

  .search-panel {
    display: flex;
    width: min(100% - 44px, 980px);
    height: min(88vh, 880px);
    flex-direction: column;
    padding: 40px;
    border: 1px solid var(--glass-border);
    border-radius: 28px;
    margin: 6vh auto;
    background: var(--glass-bg);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.64),
      0 40px 120px -30px rgba(0, 0, 0, 0.52);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    overflow-y: auto;
    overscroll-behavior: contain;
    animation: search-panel-in 420ms var(--ease) both;
  }

  .search-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
  }

  .search-heading {
    display: grid;
    gap: 8px;
  }

  .search-label {
    color: var(--blue);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.33;
  }

  .search-heading h2 {
    font-size: clamp(32px, 4.6vw, 48px);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.04em;
  }

  .search-close {
    display: grid;
    width: 34px;
    height: 34px;
    flex: none;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--ink-secondary);
    cursor: pointer;
    place-items: center;
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  .search-close:hover {
    background: var(--bg-secondary);
    color: var(--ink);
  }

  .search-close svg {
    width: 18px;
    height: 18px;
  }

  .search-field {
    display: flex;
    gap: 14px;
    align-items: center;
    padding: 22px 0 16px;
    border-bottom: 1px solid var(--line);
    margin-top: 28px;
  }

  .search-field > svg {
    width: 24px;
    height: 24px;
    flex: none;
    color: var(--ink-tertiary);
  }

  .search-field input {
    width: 100%;
    min-width: 0;
    padding: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(24px, 3.6vw, 36px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }

  .search-field input::placeholder {
    color: var(--ink-tertiary);
    font-weight: 400;
  }

  .search-field input::-webkit-search-cancel-button {
    display: none;
    -webkit-appearance: none;
    appearance: none;
  }

  .search-esc {
    flex: none;
    color: var(--ink-tertiary);
    font-size: 11px;
    line-height: 1.4;
  }

  .search-status {
    padding-top: 14px;
    color: var(--ink-secondary);
    font-size: 12px;
    line-height: 1.5;
  }

  .search-results {
    list-style: none;
  }

  :global(.search-result) {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) auto;
    gap: 16px;
    align-items: start;
    padding: 22px 0;
    border-top: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
    transition: color 160ms ease;
  }

  :global(.search-results li:first-child .search-result) {
    margin-top: 18px;
    border-top: 1px solid var(--line);
  }

  :global(.search-result:hover h3) {
    color: var(--blue);
  }

  :global(.search-result__type) {
    padding-top: 2px;
    color: var(--blue);
    font-size: 12px;
    font-weight: 400;
    line-height: 1.5;
  }

  :global(.search-result__body) {
    min-width: 0;
  }

  :global(.search-result h3) {
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.02em;
    transition: color 160ms ease;
  }

  :global(.search-result p) {
    display: -webkit-box;
    margin-top: 4px;
    color: var(--ink-secondary);
    font-size: 14px;
    line-height: 1.5;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
  }

  :global(.search-result__meta) {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 8px;
    color: var(--ink-tertiary);
    font-size: 12px;
  }

  :global(.search-result__meta span + span::before) {
    margin-right: 6px;
    content: '·';
  }

  :global(.search-result__arrow) {
    color: var(--ink-tertiary);
    font-size: 20px;
    line-height: 1;
    transition:
      color 160ms ease,
      transform 160ms ease;
  }

  :global(.search-result:hover .search-result__arrow),
  :global(.search-result.is-active .search-result__arrow) {
    color: var(--blue);
    transform: translateX(2px);
  }

  :global(.search-result.is-active h3) {
    color: var(--blue);
  }

  :global(.search-result mark) {
    border-radius: 2px;
    background: rgba(0, 113, 227, 0.13);
    color: var(--blue);
  }

  .search-empty {
    display: grid;
    gap: 8px;
    padding: 44px 0;
    border-top: 1px solid var(--line);
    margin-top: 18px;
    color: var(--ink-secondary);
    font-size: 14px;
  }

  .search-empty p {
    color: var(--ink);
    font-size: 17px;
  }

  .search-empty a {
    color: var(--blue);
    text-underline-offset: 3px;
  }

  .search-empty a:hover {
    text-decoration: underline;
  }

  .search-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
    align-items: center;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    margin-top: auto;
    color: var(--ink-tertiary);
    font-size: 12px;
    line-height: 1.5;
  }

  .search-foot kbd {
    padding: 1px 5px;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--bg);
    color: var(--ink-secondary);
    font-family: var(--font-sans);
    font-size: 10px;
  }

  .search-foot__aside {
    margin-left: auto;
  }

  @keyframes search-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes search-panel-in {
    from {
      opacity: 0;
      filter: blur(8px);
      transform: translateY(14px) scale(0.985);
    }
    to {
      opacity: 1;
      filter: blur(0);
      transform: translateY(0) scale(1);
    }
  }

  @media (max-width: 734px) {
    .search-panel {
      width: calc(100% - 24px);
      height: calc(100% - 24px);
      padding: 26px 18px 16px;
      border-radius: 22px;
      margin: 12px auto;
    }

    .search-heading h2 {
      font-size: 32px;
    }

    .search-field {
      margin-top: 22px;
      padding-top: 18px;
    }

    .search-field input {
      font-size: 24px;
    }

    :global(.search-result) {
      grid-template-columns: 54px minmax(0, 1fr) auto;
      gap: 12px;
      padding: 18px 0;
    }

    :global(.search-result__type) {
      font-size: 11px;
    }

    :global(.search-result h3) {
      font-size: 16px;
    }

    :global(.search-result p) {
      -webkit-line-clamp: 2;
    }

    .search-foot__aside {
      display: none;
    }
  }
</style>

<script>
  interface SearchItem {
    title: string;
    description: string;
    tags: string[];
    content: string;
    date: string;
    type: 'post' | 'note';
    url: string;
  }

  const searchWindow = window as typeof window & { __sqg1gSearchReady?: boolean };

  if (!searchWindow.__sqg1gSearchReady) {
    searchWindow.__sqg1gSearchReady = true;
    let controller: AbortController | undefined;

    const initSearch = () => {
      controller?.abort();
      controller = new AbortController();
      const { signal } = controller;

      const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]');
      const input = document.querySelector<HTMLInputElement>('[data-search-input]');
      const resultsList = document.querySelector<HTMLUListElement>('[data-search-results]');
      const status = document.querySelector<HTMLElement>('[data-search-status]');
      const empty = document.querySelector<HTMLElement>('[data-search-empty]');
      const closeButton = document.querySelector<HTMLButtonElement>('[data-search-close]');

      if (!dialog || !input || !resultsList || !status || !empty) return;

      let searchIndex: SearchItem[] | null = null;
      let indexPromise: Promise<SearchItem[]> | null = null;
      let activeIndex = -1;
      let currentResults: SearchItem[] = [];
      let inputTimer: number | undefined;

      const labelForType = (type: SearchItem['type']) => (type === 'post' ? '文章' : '笔记');

      const loadIndex = () => {
        if (indexPromise) return indexPromise;

        status.textContent = '正在准备搜索索引…';
        indexPromise = fetch('/search.json', { signal })
          .then((response) => {
            if (!response.ok) throw new Error(`HTTP ${response.status}`);
            return response.json();
          })
          .then((data: SearchItem[]) => {
            searchIndex = data;
            status.textContent = '输入关键词开始搜索。';
            return data;
          })
          .catch((error: unknown) => {
            indexPromise = null;
            if (error instanceof DOMException && error.name === 'AbortError') {
              throw error;
            }
            status.textContent = '搜索索引暂时不可用，请刷新后再试。';
            throw new Error('Unable to load search index');
          });

        return indexPromise;
      };

      const appendHighlighted = (element: HTMLElement, value: string, query: string) => {
        const needle = query.trim().toLowerCase();
        const index = needle ? value.toLowerCase().indexOf(needle) : -1;

        if (!needle || index === -1) {
          element.textContent = value;
          return;
        }

        element.append(document.createTextNode(value.slice(0, index)));
        const mark = document.createElement('mark');
        mark.textContent = value.slice(index, index + needle.length);
        element.append(mark, document.createTextNode(value.slice(index + needle.length)));
      };

      const setActive = (index: number) => {
        const items = [...resultsList.querySelectorAll<HTMLElement>('.search-result')];
        if (!items.length) return;

        activeIndex = Math.max(0, Math.min(index, items.length - 1));
        items.forEach((item, itemIndex) => {
          item.classList.toggle('is-active', itemIndex === activeIndex);
        });
        items[activeIndex]?.scrollIntoView({ block: 'nearest' });
      };

      const renderResults = (query: string) => {
        const trimmed = query.trim().toLowerCase();
        resultsList.replaceChildren();
        activeIndex = -1;

        if (!trimmed) {
          currentResults = [];
          empty.hidden = true;
          status.textContent = '输入关键词开始搜索。';
          return;
        }

        const scored = (searchIndex ?? [])
          .map((item) => {
            const title = item.title.toLowerCase();
            const description = item.description.toLowerCase();
            const tags = item.tags.join(' ').toLowerCase();
            const content = item.content.toLowerCase();
            let score = 0;

            if (title === trimmed) score += 100;
            if (title.includes(trimmed)) score += 30;
            if (tags.includes(trimmed)) score += 12;
            if (description.includes(trimmed)) score += 8;
            if (content.includes(trimmed)) score += 2;

            return { item, score };
          })
          .filter((entry) => entry.score > 0)
          .sort((a, b) => b.score - a.score)
          .slice(0, 8)
          .map((entry) => entry.item);

        currentResults = scored;

        if (!scored.length) {
          empty.hidden = false;
          status.textContent = `没有找到与「${query.trim()}」相关的内容。`;
          return;
        }

        empty.hidden = true;
        status.textContent = `找到 ${scored.length} 条相关内容。`;

        scored.forEach((item) => {
          const li = document.createElement('li');
          const link = document.createElement('a');
          link.className = 'search-result';
          link.href = item.url;

          const type = document.createElement('span');
          type.className = 'search-result__type';
          type.textContent = labelForType(item.type);

          const body = document.createElement('div');
          body.className = 'search-result__body';

          const title = document.createElement('h3');
          appendHighlighted(title, item.title, query);

          const description = document.createElement('p');
          appendHighlighted(description, item.description, query);

          const meta = document.createElement('div');
          meta.className = 'search-result__meta';
          const date = document.createElement('span');
          date.textContent = item.date;
          meta.append(date);
          if (item.tags.length) {
            const tags = document.createElement('span');
            tags.textContent = item.tags.slice(0, 3).join(' · ');
            meta.append(tags);
          }

          const arrow = document.createElement('span');
          arrow.className = 'search-result__arrow';
          arrow.setAttribute('aria-hidden', 'true');
          arrow.textContent = '›';

          body.append(title, description, meta);
          link.append(type, body, arrow);
          li.append(link);
          resultsList.append(li);
        });

        setActive(0);
      };

      const openSearch = () => {
        if (!dialog.open) {
          dialog.showModal();
          document.body.classList.add('is-locked');
        }

        loadIndex()
          .then(() => {
            renderResults(input.value);
            input.focus();
            input.select();
          })
          .catch((error: unknown) => {
            if (error instanceof DOMException && error.name === 'AbortError') return;
            input.focus();
          });
      };

      const closeSearch = () => {
        if (dialog.open) dialog.close();
      };

      document.querySelectorAll<HTMLButtonElement>('[data-search-open]').forEach((button) => {
        button.addEventListener('click', openSearch, { signal });
      });

      closeButton?.addEventListener('click', closeSearch, { signal });

      dialog.addEventListener(
        'click',
        (event) => {
          if (event.target === dialog) closeSearch();
        },
        { signal },
      );

      dialog.addEventListener(
        'close',
        () => {
          document.body.classList.remove('is-locked');
        },
        { signal },
      );

      input.addEventListener(
        'input',
        () => {
          window.clearTimeout(inputTimer);
          inputTimer = window.setTimeout(() => {
            if (searchIndex) renderResults(input.value);
          }, 90);
        },
        { signal },
      );

      document.addEventListener(
        'keydown',
        (event) => {
          const isTypingTarget =
            event.target instanceof HTMLElement &&
            (event.target.matches('input, textarea, select') || event.target.isContentEditable);

          if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
            event.preventDefault();
            openSearch();
            return;
          }

          if (!dialog.open) {
            if (event.key === '/' && !isTypingTarget) {
              event.preventDefault();
              openSearch();
            }
            return;
          }

          if (event.key === 'Escape') {
            event.preventDefault();
            closeSearch();
            return;
          }

          if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
            event.preventDefault();
            if (!currentResults.length) return;
            setActive(activeIndex + (event.key === 'ArrowDown' ? 1 : -1));
            return;
          }

          const activeResult = currentResults[activeIndex];
          if (event.key === 'Enter' && activeResult) {
            event.preventDefault();
            const resultLinks = resultsList.querySelectorAll<HTMLAnchorElement>('.search-result');
            resultLinks[activeIndex]?.click();
          }
        },
        { signal },
      );

      document.addEventListener(
        'astro:before-swap',
        () => {
          closeSearch();
          document.body.classList.remove('is-locked');
        },
        { signal },
      );

      document.body.classList.remove('is-locked');
    };

    document.addEventListener('astro:page-load', initSearch);
    initSearch();
  }
</script>
