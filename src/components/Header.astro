---
import { SITE } from '../config';

const pathname = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? pathname === '/' : pathname.startsWith(href));
---

<header class="global-nav" data-site-header>
  <div class="global-nav__inner">
    <a class="nav-brand" href="/" aria-label={`${SITE.name} 首页`}>
      {SITE.name}
    </a>

    <nav class="nav-links" aria-label="主导航">
      {SITE.nav.map((item) => (
        <a
          class:list={['nav-link', { 'is-active': isActive(item.href) }]}
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="nav-actions">
      <button
        class="nav-icon-button"
        type="button"
        data-search-open
        aria-label="搜索文章和笔记"
        title="搜索（Ctrl / ⌘ + K）"
      >
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="10.8" cy="10.8" r="6.5" stroke="currentColor" stroke-width="1.6"></circle>
          <path
            d="m15.8 15.8 4.4 4.4"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
          ></path>
        </svg>
      </button>

      <button
        class="nav-icon-button menu-toggle"
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-navigation"
        aria-label="打开菜单"
      >
        <svg class="menu-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M4 8h16M4 16h16"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
          ></path>
        </svg>
        <svg class="close-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="m6 6 12 12M18 6 6 18"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
          ></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<div id="mobile-navigation" class="mobile-menu" aria-label="移动端导航" hidden>
  <nav class="mobile-menu__nav">
    {SITE.nav.map((item) => (
      <a
        class:list={['mobile-menu__link', { 'is-active': isActive(item.href) }]}
        href={item.href}
        aria-current={isActive(item.href) ? 'page' : undefined}
      >
        {item.label}
      </a>
    ))}
  </nav>
  <div class="mobile-menu__extra">
    <a href={SITE.github} target="_blank" rel="noreferrer">
      GitHub
    </a>
    <a href="/rss.xml" data-astro-reload>
      RSS
    </a>
    <a href={SITE.repo} target="_blank" rel="noreferrer">
      站点源码
    </a>
  </div>
</div>

<style>
  .global-nav {
    position: sticky;
    z-index: 100;
    top: 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    background: rgba(251, 251, 253, 0.64);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.58);
    backdrop-filter: saturate(180%) blur(24px);
    -webkit-backdrop-filter: saturate(180%) blur(24px);
  }

  .global-nav__inner {
    display: flex;
    width: min(100% - 44px, 1024px);
    height: 48px;
    align-items: center;
    margin-inline: auto;
  }

  .nav-brand {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1;
  }

  .nav-links {
    display: flex;
    gap: 32px;
    align-items: center;
    margin-left: auto;
    margin-right: 36px;
  }

  .nav-link {
    color: rgba(29, 29, 31, 0.78);
    font-size: 12px;
    font-weight: 400;
    line-height: 1;
    transition: color 160ms ease;
  }

  .nav-link:hover {
    color: var(--ink);
  }

  .nav-link.is-active {
    color: var(--ink);
    font-weight: 500;
  }

  .nav-actions {
    display: flex;
    gap: 18px;
    align-items: center;
  }

  .nav-icon-button {
    display: grid;
    width: 24px;
    height: 24px;
    padding: 0;
    border: 0;
    background: transparent;
    color: rgba(29, 29, 31, 0.8);
    cursor: pointer;
    place-items: center;
    transition:
      color 160ms ease,
      transform 200ms var(--ease);
  }

  .nav-icon-button:hover {
    color: var(--ink);
    transform: scale(1.08);
  }

  .nav-icon-button svg {
    width: 16px;
    height: 16px;
  }

  .menu-toggle {
    display: none;
  }

  .close-icon {
    display: none;
  }

  .mobile-menu {
    position: fixed;
    z-index: 90;
    inset: 48px 0 0;
    padding: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.55);
    background: rgba(255, 255, 255, 0.68);
    box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.28);
    backdrop-filter: saturate(180%) blur(30px);
    -webkit-backdrop-filter: saturate(180%) blur(30px);
    overflow-y: auto;
    animation: menu-in 280ms var(--ease) both;
  }

  .mobile-menu__nav {
    display: grid;
    width: min(100%, 640px);
    margin-inline: auto;
  }

  .mobile-menu__link {
    padding: 21px 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.15;
    transition:
      color 180ms ease,
      padding-left 220ms var(--ease);
  }

  .mobile-menu__link:hover,
  .mobile-menu__link.is-active {
    padding-left: 6px;
    color: var(--blue);
  }

  .mobile-menu__extra {
    display: flex;
    width: min(100%, 640px);
    flex-wrap: wrap;
    gap: 14px 24px;
    margin: 36px auto 0;
  }

  .mobile-menu__extra a {
    color: var(--ink-secondary);
    font-size: 14px;
    line-height: 1.4;
  }

  .mobile-menu__extra a:hover {
    color: var(--blue);
  }

  .global-nav.menu-open .menu-icon {
    display: none;
  }

  .global-nav.menu-open .close-icon {
    display: block;
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      filter: blur(8px);
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      filter: blur(0);
      transform: translateY(0);
    }
  }

  @media (max-width: 833px) {
    .global-nav__inner {
      width: min(100% - 32px, 1024px);
    }

    .nav-links {
      display: none;
    }

    .nav-actions {
      margin-left: auto;
    }

    .menu-toggle {
      display: grid;
    }
  }

  @media (max-width: 480px) {
    .mobile-menu {
      padding: 20px 18px;
    }

    .mobile-menu__link {
      padding: 19px 0;
      font-size: 26px;
    }
  }
</style>

<script>
  const headerWindow = window as typeof window & { __sqg1gHeaderReady?: boolean };

  if (!headerWindow.__sqg1gHeaderReady) {
    headerWindow.__sqg1gHeaderReady = true;
    let controller: AbortController | undefined;

    const initHeader = () => {
      controller?.abort();
      controller = new AbortController();
      const { signal } = controller;

      const header = document.querySelector<HTMLElement>('[data-site-header]');
      const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      const mobileMenu = document.querySelector<HTMLElement>('#mobile-navigation');

      if (!header || !menuButton || !mobileMenu) return;

      const closeMenu = () => {
        header.classList.remove('menu-open');
        mobileMenu.hidden = true;
        menuButton.setAttribute('aria-expanded', 'false');
        menuButton.setAttribute('aria-label', '打开菜单');
        document.body.classList.remove('is-locked');
      };

      const openMenu = () => {
        header.classList.add('menu-open');
        mobileMenu.hidden = false;
        menuButton.setAttribute('aria-expanded', 'true');
        menuButton.setAttribute('aria-label', '关闭菜单');
        document.body.classList.add('is-locked');
        mobileMenu.querySelector<HTMLAnchorElement>('a')?.focus({ preventScroll: true });
      };

      menuButton.addEventListener(
        'click',
        () => {
          if (mobileMenu.hidden) openMenu();
          else closeMenu();
        },
        { signal },
      );

      mobileMenu.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', closeMenu, { signal });
      });

      document.querySelectorAll('[data-search-open]').forEach((button) => {
        button.addEventListener('click', closeMenu, { signal });
      });

      document.addEventListener(
        'keydown',
        (event) => {
          if (event.key === 'Escape') closeMenu();
        },
        { signal },
      );

      window.addEventListener(
        'resize',
        () => {
          if (window.innerWidth > 833) closeMenu();
        },
        { signal },
      );

      closeMenu();
    };

    document.addEventListener('astro:page-load', initHeader);
    initHeader();
  }
</script>
