---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config';
import type { WritingEntry } from '../lib/content';
import { NOTE_STATUS, entryHref, formatDate, getReadingTime, tagHref } from '../lib/content';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  entry: WritingEntry;
  headings: Heading[];
  previous?: WritingEntry;
  next?: WritingEntry;
}

const { entry, headings, previous, next } = Astro.props;
const isNote = entry.collection === 'notes';
const noteStatus = isNote ? NOTE_STATUS[entry.data.status] : null;
const noteStatusKey = isNote ? entry.data.status : null;
const href = entryHref(entry);
const readingTime = getReadingTime(entry.body);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);

const rawFilePath = entry.filePath?.replaceAll('\\', '/') ?? '';
const filePath =
  rawFilePath.match(/src\/content\/.*$/)?.[0] ??
  `src/content/${entry.collection}/${entry.id}${/\.(md|mdx)$/i.test(entry.id) ? '' : '.md'}`;
const editUrl = `${SITE.repo}/edit/main/${filePath}`;
const articleUrl = new URL(href, SITE.url).href;
const kindLabel = isNote ? '笔记' : '文章';

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': isNote ? 'TechArticle' : 'BlogPosting',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.date.toISOString(),
  dateModified: (entry.data.updated ?? entry.data.date).toISOString(),
  inLanguage: SITE.locale,
  url: articleUrl,
  mainEntityOfPage: articleUrl,
  keywords: entry.data.tags.join(', '),
  author: {
    '@type': 'Person',
    name: SITE.author.name,
    url: SITE.github,
  },
  publisher: {
    '@type': 'Person',
    name: SITE.author.name,
    url: SITE.github,
  },
};
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  type="article"
  publishedTime={entry.data.date}
  updatedTime={entry.data.updated}
  tags={[...entry.data.tags]}
>
  <script
    type="application/ld+json"
    is:inline
    slot="head"
    set:html={JSON.stringify(articleSchema)}
  />
  <div class="reading-progress" aria-hidden="true">
    <span data-reading-progress></span>
  </div>

  <article>
    <header class="article-header">
      <div class="container--text article-header__inner">
        <div class="article-kicker">
          <span class="article-kind">{kindLabel}</span>
          {noteStatus && noteStatusKey && (
            <span class="article-status">
              <span
                class:list={['article-status__dot', `article-status__dot--${noteStatusKey}`]}
                aria-hidden="true"
              ></span>
              {noteStatus.label}
            </span>
          )}
        </div>

        <h1>{entry.data.title}</h1>
        <p class="article-deck">{entry.data.description}</p>

        <div class="article-meta">
          <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
          <span aria-hidden="true">·</span>
          <span>{readingTime} 分钟阅读</span>
          {entry.data.updated && (
            <>
              <span aria-hidden="true">·</span>
              <span>更新于 {formatDate(entry.data.updated)}</span>
            </>
          )}
        </div>

        {entry.data.tags.length > 0 && (
          <ul class="article-tags" aria-label="文章标签">
            {entry.data.tags.map((tag) => (
              <li>
                <a class="tag" href={tagHref(tag)}>
                  {tag}
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </header>

    <div class="article-body">
      <div class="article-content">
        {toc.length > 0 && (
          <details class="article-toc">
            <summary>
              <span>目录</span>
              <span class="article-toc__count">{toc.length} 节</span>
              <span class="article-toc__chevron" aria-hidden="true">
                ⌄
              </span>
            </summary>
            <nav aria-label="本页目录">
              <ol>
                {toc.map((heading) => (
                  <li class:list={[`article-toc__item--${heading.depth}`]}>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          </details>
        )}

        <div class="prose" data-article-body>
          <slot />
        </div>

        <footer class="article-footer">
          <div class="article-footer__top">
            <p>
              写于 {formatDate(entry.data.date)}。如果这篇内容对你有帮助，或者你有不同的想法，欢迎在
              <a href={SITE.github} target="_blank" rel="noreferrer">
                GitHub
              </a>{' '}
              找我。
            </p>
            <a class="article-edit" href={editUrl} target="_blank" rel="noreferrer">
              在 GitHub 上编辑
            </a>
          </div>

          <div class="article-author">
            <div>
              <p class="article-author__name">{SITE.author.name}</p>
              <p class="article-author__bio">{SITE.author.intro}</p>
            </div>
            <a
              class="text-link text-link--small"
              href={SITE.github}
              target="_blank"
              rel="noreferrer"
            >
              GitHub
            </a>
          </div>

          {(previous || next) && (
            <nav class="article-pager" aria-label="前后篇">
              {previous ? (
                <a class="article-pager__item" href={entryHref(previous)}>
                  <span class="article-pager__label">上一篇</span>
                  <span class="article-pager__title">{previous.data.title}</span>
                </a>
              ) : (
                <span class="article-pager__empty" aria-hidden="true"></span>
              )}
              {next ? (
                <a class="article-pager__item article-pager__item--next" href={entryHref(next)}>
                  <span class="article-pager__label">下一篇</span>
                  <span class="article-pager__title">{next.data.title}</span>
                </a>
              ) : (
                <span class="article-pager__empty" aria-hidden="true"></span>
              )}
            </nav>
          )}
        </footer>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .reading-progress {
    position: fixed;
    z-index: 110;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: transparent;
    pointer-events: none;
  }

  .reading-progress span {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--blue);
    transform: scaleX(0);
    transform-origin: left center;
  }

  .article-header {
    padding-block: clamp(64px, 9vw, 104px) clamp(56px, 7vw, 80px);
    background: var(--bg-secondary);
  }

  .article-header__inner {
    display: flex;
    align-items: center;
    flex-direction: column;
    text-align: center;
  }

  .article-kicker {
    display: flex;
    gap: 10px;
    align-items: center;
    color: var(--ink-secondary);
    font-size: 12px;
    line-height: 1.4;
  }

  .article-kind {
    color: var(--blue);
    font-weight: 600;
  }

  .article-status {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    color: var(--ink-secondary);
  }

  .article-status__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ink-tertiary);
  }

  .article-status__dot--seedling {
    background: var(--orange);
  }

  .article-status__dot--growing {
    background: var(--green);
  }

  .article-status__dot--evergreen {
    background: var(--blue);
  }

  .article-header h1 {
    max-width: 100%;
    margin-top: 22px;
    color: var(--ink);
    font-size: clamp(38px, 5.2vw, 60px);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -0.042em;
  }

  .article-deck {
    max-width: 62ch;
    margin-top: 22px;
    color: var(--ink-secondary);
    font-size: clamp(17px, 1.7vw, 21px);
    line-height: 1.5;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    justify-content: center;
    margin-top: 24px;
    color: var(--ink-tertiary);
    font-size: 12px;
    line-height: 1.5;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    justify-content: center;
    margin-top: 20px;
    list-style: none;
  }

  .article-body {
    padding-block: clamp(56px, 7vw, 80px) clamp(80px, 10vw, 120px);
    background: var(--bg);
  }

  .article-content {
    width: min(100% - (var(--gutter) * 2), var(--article-width));
    margin-inline: auto;
  }

  .article-toc {
    padding-block: 18px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    margin-bottom: 48px;
    color: var(--ink-secondary);
  }

  .article-toc summary {
    display: flex;
    gap: 12px;
    align-items: center;
    font-size: 14px;
    line-height: 1.4;
    cursor: pointer;
    list-style: none;
  }

  .article-toc summary::-webkit-details-marker {
    display: none;
  }

  .article-toc summary span:first-child {
    color: var(--ink);
    font-weight: 500;
  }

  .article-toc__count {
    color: var(--ink-tertiary);
    font-size: 12px;
  }

  .article-toc__chevron {
    margin-left: auto;
    color: var(--ink-tertiary);
    font-size: 16px;
    transition: transform 160ms ease;
  }

  .article-toc[open] .article-toc__chevron {
    transform: rotate(180deg);
  }

  .article-toc nav {
    padding-top: 16px;
  }

  .article-toc ol {
    display: grid;
    gap: 10px;
    list-style: none;
  }

  .article-toc a {
    color: var(--blue);
    font-size: 14px;
    line-height: 1.5;
  }

  .article-toc a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .article-toc__item--3 {
    padding-left: 18px;
  }

  .article-footer {
    padding-top: 28px;
    border-top: 1px solid var(--line);
    margin-top: 64px;
  }

  .article-footer__top {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 28px;
    align-items: flex-start;
    justify-content: space-between;
    color: var(--ink-secondary);
    font-size: 14px;
    line-height: 1.6;
  }

  .article-footer__top p {
    max-width: 52ch;
  }

  .article-footer__top a {
    color: var(--blue);
  }

  .article-edit {
    flex: none;
    font-size: 12px;
    color: var(--ink-secondary) !important;
  }

  .article-edit:hover {
    color: var(--blue) !important;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .article-author {
    display: flex;
    gap: 24px;
    align-items: center;
    justify-content: space-between;
    padding-block: 24px;
    border-bottom: 1px solid var(--line);
    margin-top: 28px;
  }

  .article-author__name {
    color: var(--ink);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.3;
  }

  .article-author__bio {
    margin-top: 4px;
    color: var(--ink-secondary);
    font-size: 14px;
    line-height: 1.5;
  }

  .article-pager {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 28px;
  }

  .article-pager__item {
    display: flex;
    min-height: 116px;
    flex-direction: column;
    gap: 10px;
    justify-content: space-between;
    padding: 22px;
    border-radius: 12px;
    background: var(--bg-secondary);
    color: var(--ink);
    text-decoration: none;
    transition: background-color 160ms ease;
  }

  .article-pager__item:hover {
    background: #ececf0;
  }

  .article-pager__item--next {
    text-align: right;
  }

  .article-pager__label {
    color: var(--ink-tertiary);
    font-size: 12px;
  }

  .article-pager__title {
    font-size: 17px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.015em;
  }

  .article-pager__empty {
    min-height: 116px;
  }

  @media (max-width: 734px) {
    .article-header {
      padding-block: 48px 44px;
    }

    .article-header h1 {
      max-width: 100%;
      margin-top: 16px;
      font-size: clamp(34px, 10vw, 44px);
    }

    .article-deck {
      margin-top: 16px;
      font-size: 17px;
    }

    .article-meta {
      margin-top: 20px;
    }

    .article-tags {
      margin-top: 16px;
    }

    .article-body {
      padding-block: 44px 72px;
    }

    .article-toc {
      margin-bottom: 36px;
    }

    .article-footer {
      margin-top: 48px;
    }

    .article-footer__top {
      flex-direction: column;
    }

    .article-author {
      align-items: flex-start;
      flex-direction: column;
      gap: 12px;
    }

    .article-pager {
      grid-template-columns: 1fr;
    }

    .article-pager__empty {
      display: none;
    }

    .article-pager__item--next {
      text-align: left;
    }
  }

  @media print {
    .reading-progress,
    .article-toc,
    .article-footer,
    .article-author,
    .article-pager {
      display: none !important;
    }

    .article-header {
      padding: 0 0 24px;
      background: transparent;
    }

    .article-body {
      padding: 0;
    }
  }
</style>

<script>
  const articleWindow = window as typeof window & { __sqg1gArticleReady?: boolean };

  if (!articleWindow.__sqg1gArticleReady) {
    articleWindow.__sqg1gArticleReady = true;
    let controller: AbortController | undefined;

    const initArticle = () => {
      controller?.abort();
      controller = new AbortController();
      const { signal } = controller;

      const progressBar = document.querySelector<HTMLElement>('[data-reading-progress]');
      const articleBody = document.querySelector<HTMLElement>('[data-article-body]');
      if (!progressBar || !articleBody) return;

      const updateProgress = () => {
        const articleTop = articleBody.getBoundingClientRect().top + window.scrollY;
        const articleHeight = articleBody.offsetHeight;
        const start = articleTop - 120;
        const end = articleTop + articleHeight - window.innerHeight + 220;
        const ratio = (window.scrollY - start) / Math.max(1, end - start);
        progressBar.style.transform = `scaleX(${Math.min(1, Math.max(0, ratio))})`;
      };

      updateProgress();
      window.addEventListener('scroll', updateProgress, { passive: true, signal });
      window.addEventListener('resize', updateProgress, { signal });

      document.querySelectorAll<HTMLElement>('.prose h2[id], .prose h3[id]').forEach((heading) => {
        if (heading.querySelector(':scope > .heading-anchor')) return;

        const anchor = document.createElement('a');
        anchor.className = 'heading-anchor';
        anchor.href = `#${heading.id}`;
        anchor.textContent = '#';
        anchor.setAttribute('aria-label', '链接到此标题');
        heading.prepend(anchor);
      });

      document.querySelectorAll<HTMLElement>('.prose pre').forEach((pre) => {
        if (pre.querySelector(':scope > [data-code-copy]')) return;

        const button = document.createElement('button');
        button.type = 'button';
        button.dataset.codeCopy = '';
        button.textContent = '复制';
        button.setAttribute('aria-label', '复制代码');
        pre.append(button);

        button.addEventListener(
          'click',
          async () => {
            const code = pre.querySelector('code')?.innerText ?? pre.innerText;
            try {
              await navigator.clipboard.writeText(code);
              button.textContent = '已复制';
              window.setTimeout(() => {
                button.textContent = '复制';
              }, 1600);
            } catch {
              button.textContent = '复制失败';
              window.setTimeout(() => {
                button.textContent = '复制';
              }, 1600);
            }
          },
          { signal },
        );
      });

      document.querySelectorAll<HTMLAnchorElement>('.prose a[href^="http"]').forEach((link) => {
        try {
          if (new URL(link.href).hostname !== window.location.hostname) {
            link.target = '_blank';
            link.rel = 'noreferrer noopener';
          }
        } catch {
          // Leave malformed links alone.
        }
      });

      document.addEventListener(
        'astro:before-swap',
        () => {
          progressBar.style.transform = 'scaleX(0)';
        },
        { signal },
      );
    };

    document.addEventListener('astro:page-load', initArticle);
    initArticle();
  }
</script>
