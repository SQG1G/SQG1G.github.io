---
import BaseLayout from '../layouts/BaseLayout.astro';
import NoteCard from '../components/NoteCard.astro';
import PostCard from '../components/PostCard.astro';
import { SITE } from '../config';
import { getNotes, getPosts, getTagSummaries } from '../lib/content';

const [posts, notes, tags] = await Promise.all([getPosts(), getNotes(), getTagSummaries()]);
const latestPosts = posts.slice(0, 3);
const latestNotes = notes.slice(0, 3);
const [featuredPost, ...secondaryPosts] = latestPosts;
---

<BaseLayout description={SITE.description}>
  <section class="hero">
    <div class="container--text hero__inner">
      <p class="hero__eyebrow">{SITE.hero.eyebrow}</p>
      <h1>
        <span>{SITE.hero.titleBefore}</span>
        <span>
          {SITE.hero.titleEmphasis}
          {SITE.hero.titleAfter}
        </span>
      </h1>
      <p class="hero__intro">{SITE.hero.intro}</p>
      <div class="hero__links">
        <a class="text-link" href="/posts/">
          阅读最新文章
        </a>
        <a class="text-link" href="/notes/">
          逛逛笔记
        </a>
      </div>
      <div class="hero__stats" aria-label="站点内容统计">
        <span>{String(posts.length).padStart(2, '0')} 篇文章</span>
        <span aria-hidden="true">·</span>
        <span>{String(notes.length).padStart(2, '0')} 则笔记</span>
        <span aria-hidden="true">·</span>
        <span>{String(tags.length).padStart(2, '0')} 个标签</span>
      </div>
    </div>
  </section>

  <section class="section latest" aria-labelledby="latest-heading">
    <div class="container">
      <div class="section-head">
        <div class="section-head__copy">
          <p class="section-label">最新文章</p>
          <h2 id="latest-heading" class="section-title">
            最近写下的。
          </h2>
          <p class="section-note">
            完整的思考需要一点时间。这里放较长的文章，关于代码、系统与日常。
          </p>
        </div>
        <a class="text-link section-head__link" href="/posts/">
          全部文章
        </a>
      </div>

      {featuredPost ? (
        <>
          <PostCard entry={featuredPost} featured />
          {secondaryPosts.length > 0 && (
            <div class="post-grid">
              {secondaryPosts.map((post) => (
                <PostCard entry={post} />
              ))}
            </div>
          )}
        </>
      ) : (
        <p class="empty-state">第一篇文章正在路上。</p>
      )}
    </div>
  </section>

  <section class="section section--dark notes-home" aria-labelledby="notes-heading">
    <div class="container">
      <div class="section-head">
        <div class="section-head__copy">
          <p class="section-label">技术笔记</p>
          <h2 id="notes-heading" class="section-title">
            还在生长的笔记。
          </h2>
          <p class="section-note">没有完成时。短一点、轻一点，先记下来，再慢慢养大。</p>
        </div>
        <a class="text-link section-head__link" href="/notes/">
          全部笔记
        </a>
      </div>

      {latestNotes.length > 0 ? (
        <div class="notes-grid">
          {latestNotes.map((note) => (
            <NoteCard entry={note} dark />
          ))}
        </div>
      ) : (
        <p class="empty-state">笔记还在发芽。</p>
      )}
    </div>
  </section>

  <section class="section section--gray about-home" aria-labelledby="about-heading">
    <div class="container--text about-home__inner">
      <p class="section-label">关于</p>
      <h2 id="about-heading">一个用来认真想事情的地方。</h2>
      <p>{SITE.about.paragraphs[0]}</p>
      <a class="text-link" href="/about/">
        更多关于我
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(104px, 14vw, 168px) clamp(94px, 12vw, 144px);
    background: var(--dark);
    color: var(--dark-text);
    text-align: center;
  }

  .hero__inner {
    display: flex;
    align-items: center;
    flex-direction: column;
  }

  .hero__eyebrow {
    color: var(--dark-secondary);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.4;
  }

  .hero h1 {
    max-width: 16ch;
    margin-top: 16px;
    color: var(--dark-text);
    font-size: clamp(48px, 8.6vw, 80px);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.048em;
  }

  .hero h1 span {
    display: block;
  }

  .hero__intro {
    max-width: 40em;
    margin-top: 24px;
    color: var(--dark-secondary);
    font-size: clamp(19px, 2vw, 24px);
    line-height: 1.42;
    letter-spacing: -0.015em;
  }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 32px;
    align-items: center;
    justify-content: center;
    margin-top: 32px;
  }

  .hero .text-link {
    color: var(--blue-on-dark);
    font-size: 19px;
  }

  .hero .text-link:hover {
    color: #6bb7ff;
  }

  .hero__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    justify-content: center;
    margin-top: 56px;
    color: var(--ink-tertiary);
    font-size: 12px;
    line-height: 1.4;
  }

  .hero__stats span[aria-hidden='true'] {
    color: var(--dark-line);
  }

  .latest {
    background: var(--bg);
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 16px;
  }

  .notes-home {
    padding-block: clamp(80px, 10vw, 120px);
  }

  .notes-home .section-note {
    color: var(--dark-secondary);
  }

  .notes-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .about-home {
    text-align: center;
  }

  .about-home__inner {
    display: flex;
    align-items: center;
    flex-direction: column;
  }

  .about-home h2 {
    max-width: 18ch;
    margin-top: 14px;
    font-size: clamp(32px, 4.6vw, 48px);
    line-height: 1.08;
    letter-spacing: -0.038em;
  }

  .about-home p:not(.section-label) {
    max-width: 60ch;
    margin-top: 18px;
    color: var(--ink-secondary);
    font-size: clamp(17px, 1.7vw, 21px);
    line-height: 1.5;
  }

  .about-home .text-link {
    margin-top: 26px;
    font-size: 19px;
  }

  .empty-state {
    padding: 56px 0;
    border-top: 1px solid var(--line);
    color: var(--ink-secondary);
    font-size: 17px;
  }

  @media (max-width: 1068px) {
    .notes-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .notes-grid > :last-child {
      grid-column: span 2;
    }
  }

  @media (max-width: 734px) {
    .hero {
      padding-block: 76px 72px;
    }

    .hero h1 {
      max-width: 11ch;
      font-size: clamp(44px, 12vw, 56px);
    }

    .hero__intro {
      margin-top: 20px;
      font-size: 17px;
      line-height: 1.5;
    }

    .hero__links {
      margin-top: 28px;
    }

    .hero .text-link {
      font-size: 17px;
    }

    .hero__stats {
      margin-top: 40px;
    }

    .post-grid,
    .notes-grid {
      grid-template-columns: 1fr;
    }

    .notes-grid > :last-child {
      grid-column: auto;
    }

    .about-home h2 {
      font-size: 32px;
    }

    .about-home p:not(.section-label) {
      font-size: 17px;
    }

    .about-home .text-link {
      font-size: 17px;
    }
  }
</style>
