---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { SITE } from '../config';

const nowItems = SITE.now.items;
const principles = SITE.about.principles;
---

<BaseLayout title="关于" description={`关于 ${SITE.name} 和这个小小的数字花园。`}>
  <PageHeader
    eyebrow="关于 SQG1G"
    title="你好，我是 SQG1G。"
    description={SITE.about.lead}
    meta="写代码，也写点别的。"
  />

  <section class="section about-intro">
    <div class="container--text about-intro__inner">
      <p class="section-label">为什么写</p>
      <h2>把复杂的事，尽量写清楚。</h2>
      <div class="about-intro__copy">
        {SITE.about.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--gray principles" aria-labelledby="principles-heading">
    <div class="container">
      <div class="section-head">
        <div class="section-head__copy">
          <p class="section-label">原则</p>
          <h2 id="principles-heading" class="section-title">
            几条小小的原则。
          </h2>
        </div>
        <p class="section-note">不是教条，只是写到卡住的时候，会拿出来看看的提醒。</p>
      </div>

      <div class="principles-grid">
        {principles.map((principle, index) => (
          <article class="principle">
            <span class="principle__index">{String(index + 1).padStart(2, '0')}</span>
            <h3>{principle.title}</h3>
            <p>{principle.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section about-now" aria-labelledby="now-heading">
    <div class="container about-now__grid">
      <div class="about-now__intro">
        <p class="section-label">最近</p>
        <h2 id="now-heading">最近在忙什么。</h2>
        <p>不追求高频更新，但希望每次回来，都能留下一点新的东西。</p>
      </div>
      <ul class="about-now__list">
        {nowItems.map((item, index) => (
          <li>
            <span>{String(index + 1).padStart(2, '0')}</span>
            {item}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--gray colophon" aria-labelledby="colophon-heading">
    <div class="container colophon__grid">
      <div class="colophon__intro">
        <p class="section-label">关于这个站点</p>
        <h2 id="colophon-heading">这个站点是怎么搭的。</h2>
        <p>
          用{' '}
          <a href="https://astro.build" target="_blank" rel="noreferrer">
            Astro
          </a>{' '}
          构建的静态站点：内容写在 Markdown 里，推送代码后由 GitHub Actions 自动构建并发布到 GitHub
          Pages。没有数据库，没有追踪脚本。
        </p>
        <a class="text-link" href={SITE.repo} target="_blank" rel="noreferrer">
          查看站点源码
        </a>
      </div>

      <dl class="facts">
        <div>
          <dt>框架</dt>
          <dd>Astro</dd>
        </div>
        <div>
          <dt>内容</dt>
          <dd>Markdown + Content Collections</dd>
        </div>
        <div>
          <dt>字体</dt>
          <dd>SF Pro / Inter / Noto Sans SC</dd>
        </div>
        <div>
          <dt>托管</dt>
          <dd>GitHub Pages</dd>
        </div>
        <div>
          <dt>更新方式</dt>
          <dd>Git push → 自动部署</dd>
        </div>
        <div>
          <dt>联系</dt>
          <dd>
            <a href={SITE.github} target="_blank" rel="noreferrer">
              GitHub
            </a>{' '}
            /{' '}
            <a href="/rss.xml" data-astro-reload>
              RSS
            </a>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section about-contact">
    <div class="container--text about-contact__inner">
      <p class="section-label">联系</p>
      <h2>有想法，来聊聊。</h2>
      <p>如果你也在搭自己的小系统，或者只是想聊聊某个想法，欢迎在 GitHub 找我。</p>
      <a class="text-link" href={SITE.github} target="_blank" rel="noreferrer">
        去 GitHub
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .about-intro {
    background: var(--bg);
  }

  .about-intro__inner {
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .about-intro h2 {
    max-width: 18ch;
    margin-top: 14px;
    font-size: clamp(34px, 5vw, 56px);
    line-height: 1.06;
    letter-spacing: -0.04em;
  }

  .about-intro__copy {
    display: grid;
    gap: 18px;
    max-width: 680px;
    margin-top: 36px;
    color: var(--ink-secondary);
    font-size: clamp(17px, 1.7vw, 19px);
    line-height: 1.7;
    text-align: left;
  }

  .principles {
    padding-block: clamp(72px, 9vw, 112px);
  }

  .principles-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px;
    border-top: 1px solid var(--line);
    padding-top: 28px;
  }

  .principle {
    display: flex;
    flex-direction: column;
  }

  .principle__index {
    color: var(--ink-tertiary);
    font-size: 12px;
    line-height: 1.4;
  }

  .principle h3 {
    max-width: 14ch;
    margin-top: 28px;
    font-size: 24px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.03em;
  }

  .principle p {
    margin-top: 12px;
    color: var(--ink-secondary);
    font-size: 15px;
    line-height: 1.6;
  }

  .about-now__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
    gap: clamp(40px, 8vw, 96px);
    align-items: start;
  }

  .about-now__intro h2 {
    margin-top: 14px;
    font-size: clamp(32px, 4.2vw, 48px);
    line-height: 1.08;
    letter-spacing: -0.038em;
  }

  .about-now__intro > p:not(.section-label) {
    max-width: 36ch;
    margin-top: 16px;
    color: var(--ink-secondary);
    font-size: 17px;
    line-height: 1.6;
  }

  .about-now__list {
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .about-now__list li {
    display: flex;
    gap: 20px;
    align-items: baseline;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-size: 17px;
    line-height: 1.5;
  }

  .about-now__list li span {
    color: var(--ink-tertiary);
    font-size: 12px;
  }

  .colophon__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
    gap: clamp(40px, 8vw, 96px);
    align-items: start;
  }

  .colophon__intro h2 {
    max-width: 14ch;
    margin-top: 14px;
    font-size: clamp(32px, 4.2vw, 48px);
    line-height: 1.08;
    letter-spacing: -0.038em;
  }

  .colophon__intro > p:not(.section-label) {
    max-width: 48ch;
    margin-top: 16px;
    color: var(--ink-secondary);
    font-size: 17px;
    line-height: 1.6;
  }

  .colophon__intro > .text-link {
    margin-top: 24px;
    font-size: 17px;
  }

  .colophon__intro a:not(.text-link) {
    color: var(--blue);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }

  .facts div {
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }

  .facts div:nth-child(odd) {
    padding-right: 20px;
  }

  .facts dt {
    color: var(--ink-tertiary);
    font-size: 12px;
    line-height: 1.4;
  }

  .facts dd {
    margin: 6px 0 0;
    color: var(--ink);
    font-size: 14px;
    line-height: 1.5;
  }

  .facts a {
    color: var(--blue);
  }

  .about-contact {
    text-align: center;
  }

  .about-contact__inner {
    display: flex;
    align-items: center;
    flex-direction: column;
  }

  .about-contact h2 {
    margin-top: 14px;
    font-size: clamp(32px, 4.6vw, 48px);
    line-height: 1.08;
    letter-spacing: -0.038em;
  }

  .about-contact p:not(.section-label) {
    max-width: 52ch;
    margin-top: 16px;
    color: var(--ink-secondary);
    font-size: 17px;
    line-height: 1.6;
  }

  .about-contact .text-link {
    margin-top: 24px;
    font-size: 19px;
  }

  @media (max-width: 734px) {
    .about-intro__copy {
      margin-top: 28px;
    }

    .principles-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .principle h3 {
      margin-top: 14px;
      font-size: 22px;
    }

    .about-now__grid,
    .colophon__grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .facts {
      grid-template-columns: 1fr;
    }

    .facts div:nth-child(odd) {
      padding-right: 0;
    }
  }
</style>
