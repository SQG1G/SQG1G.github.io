---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import NoteCard from '../../components/NoteCard.astro';
import { NOTE_STATUS, getNotes } from '../../lib/content';

const notes = await getNotes();
const statuses = Object.entries(NOTE_STATUS).map(([key, status]) => ({ key, ...status }));
---

<BaseLayout title="笔记" description="更短、更轻的知识花园：学习记录、工具片段和不完整的想法。">
  <PageHeader
    eyebrow="笔记"
    title="笔记。"
    description="不是每篇内容都需要「完成」。这里放更短的记录、工具片段和尚未想透的问题，允许它们慢慢长大。"
    meta={`${notes.length} 则笔记`}
  />

  <section class="section notes-archive" aria-label="笔记列表">
    <div class="container">
      <div class="status-legend" aria-label="笔记状态说明">
        {statuses.map((status) => (
          <span class="status-legend__item">
            <span
              class:list={['status-legend__dot', `status-legend__dot--${status.key}`]}
              aria-hidden="true"
            ></span>
            <strong>{status.label}</strong>
            <span>{status.description}</span>
          </span>
        ))}
      </div>

      {notes.length > 0 ? (
        <div class="notes-grid">
          {notes.map((note) => (
            <NoteCard entry={note} />
          ))}
        </div>
      ) : (
        <p class="notes-empty">花园刚刚翻土。</p>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .notes-archive {
    padding-block: 48px 96px;
  }

  .status-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--line);
    color: var(--ink-secondary);
    font-size: 12px;
    line-height: 1.5;
  }

  .status-legend__item {
    display: inline-flex;
    gap: 8px;
    align-items: center;
  }

  .status-legend__item strong {
    color: var(--ink);
    font-weight: 500;
  }

  .status-legend__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ink-tertiary);
  }

  .status-legend__dot--seedling {
    background: var(--orange);
  }

  .status-legend__dot--growing {
    background: var(--green);
  }

  .status-legend__dot--evergreen {
    background: var(--blue);
  }

  .notes-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-top: 24px;
  }

  .notes-empty {
    padding: 56px 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink-secondary);
    font-size: 17px;
  }

  @media (max-width: 1068px) {
    .notes-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 734px) {
    .notes-archive {
      padding-block: 36px 64px;
    }

    .status-legend {
      align-items: flex-start;
      flex-direction: column;
      gap: 10px;
    }

    .notes-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
