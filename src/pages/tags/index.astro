---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getTagSummaries } from '../../lib/content';

const tags = await getTagSummaries();
---

<BaseLayout title="标签" description="按主题浏览文章和笔记。">
  <PageHeader
    eyebrow="标签"
    title="按主题浏览。"
    description="标签是从内容里自然长出来的。不必按顺序，挑一个此刻最好奇的方向。"
    meta={`${tags.length} 个标签`}
  />

  <section class="section tags-page" aria-label="全部标签">
    <div class="container">
      {tags.length > 0 ? (
        <div class="tag-index">
          {tags.map((tag) => (
            <a class="tag-index__item" href={tag.href}>
              <span class="tag-index__name">{tag.name}</span>
              <span class="tag-index__count">{String(tag.count).padStart(2, '0')} 篇</span>
              <span class="tag-index__arrow" aria-hidden="true">
                ›
              </span>
            </a>
          ))}
        </div>
      ) : (
        <p class="tags-empty">还没有给内容加上标签。</p>
      )}

      <p class="tags-note">
        也可以从时间顺序开始：<a href="/posts/">文章列表</a> 或 <a href="/notes/">笔记</a>。
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .tags-page {
    padding-block: 48px 96px;
  }

  .tag-index {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }

  .tag-index__item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: 16px;
    align-items: center;
    padding: 22px 20px 22px 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
    transition: background-color 160ms ease;
  }

  .tag-index__item:nth-child(odd) {
    padding-right: 40px;
    border-right: 1px solid var(--line);
  }

  .tag-index__item:nth-child(even) {
    padding-left: 40px;
  }

  .tag-index__item:hover {
    background: var(--bg-secondary);
  }

  .tag-index__item:hover .tag-index__name,
  .tag-index__item:hover .tag-index__arrow {
    color: var(--blue);
  }

  .tag-index__name {
    font-size: clamp(21px, 2vw, 24px);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.3;
    transition: color 160ms ease;
  }

  .tag-index__count {
    color: var(--ink-tertiary);
    font-size: 12px;
    white-space: nowrap;
  }

  .tag-index__arrow {
    color: var(--ink-tertiary);
    font-size: 22px;
    line-height: 1;
    transition:
      color 160ms ease,
      transform 160ms ease;
  }

  .tag-index__item:hover .tag-index__arrow {
    transform: translateX(2px);
  }

  .tags-note {
    margin-top: 28px;
    color: var(--ink-secondary);
    font-size: 14px;
    line-height: 1.5;
  }

  .tags-note a {
    color: var(--blue);
  }

  .tags-note a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .tags-empty {
    padding: 56px 0;
    border-top: 1px solid var(--line);
    color: var(--ink-secondary);
    font-size: 17px;
  }

  @media (max-width: 734px) {
    .tags-page {
      padding-block: 36px 64px;
    }

    .tag-index {
      grid-template-columns: 1fr;
    }

    .tag-index__item,
    .tag-index__item:nth-child(odd),
    .tag-index__item:nth-child(even) {
      padding: 18px 4px;
      border-right: 0;
    }
  }
</style>
