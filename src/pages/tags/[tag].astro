---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostCard from '../../components/PostCard.astro';
import NoteCard from '../../components/NoteCard.astro';
import { getWriting } from '../../lib/content';

export async function getStaticPaths() {
  const entries = await getWriting();
  const tags = [...new Set(entries.flatMap((entry) => entry.data.tags))];

  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      entries: entries.filter((entry) => entry.data.tags.includes(tag)),
    },
  }));
}

const { tag, entries } = Astro.props;
---

<BaseLayout title={tag} description={`所有带有「${tag}」标签的文章和笔记。`}>
  <PageHeader
    eyebrow="标签"
    title={tag}
    description={`这里收集了所有与「${tag}」相关的内容。`}
    meta={`${entries.length} 篇相关内容`}
  />

  <section class="section tag-archive" aria-label={`${tag} 标签下的内容`}>
    <div class="container">
      <div class="archive-bar">
        <a class="text-link text-link--small" href="/tags/">
          ← 全部标签
        </a>
        <span>按时间排序</span>
      </div>

      <div class="archive-grid">
        {entries.map((entry) =>
          entry.collection === 'posts' ? <PostCard entry={entry} /> : <NoteCard entry={entry} />,
        )}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .tag-archive {
    padding-block: 48px 96px;
  }

  .archive-bar {
    display: flex;
    gap: 20px;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--line);
    color: var(--ink-tertiary);
    font-size: 12px;
    line-height: 1.4;
  }

  .archive-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 24px;
  }

  @media (max-width: 734px) {
    .tag-archive {
      padding-block: 36px 64px;
    }

    .archive-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
