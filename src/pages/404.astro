---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面走丢了" description="这个页面去散步了。" noindex>
  <section class="not-found container page-enter">
    <div class="not-found__art" aria-hidden="true">
      <div class="not-found__sun"></div>
      <div class="not-found__orbit"></div>
      <span>404</span>
    </div>
    <div class="not-found__copy">
      <p class="eyebrow">LOST IN THE GARDEN</p>
      <h1>
        这一页
        <br />
        去散步了<span>。</span>
      </h1>
      <p>可能链接旧了，也可能这里从来没有过内容。没关系，回首页看看，或者直接搜一下。</p>
      <div class="button-row">
        <a class="button button--primary" href="/">
          回到首页
        </a>
        <button class="button button--ghost" type="button" data-search-open>
          搜索站点
        </button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    grid-template-columns: minmax(260px, 0.6fr) minmax(0, 0.8fr);
    gap: clamp(2.5rem, 8vw, 8rem);
    align-items: center;
    min-height: min(68vh, 650px);
    padding-block: clamp(2.5rem, 7vw, 6rem);
  }

  .not-found__art {
    position: relative;
    display: grid;
    width: min(100%, 400px);
    aspect-ratio: 1;
    place-items: center;
  }

  .not-found__sun {
    position: absolute;
    width: 76%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 33%, #f7c76e, #e45f3d 64%, #c74a2b);
    box-shadow: 0 30px 70px -25px rgba(228, 95, 61, 0.5);
  }

  .not-found__orbit {
    position: absolute;
    inset: 2%;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    transform: rotate(-16deg);
  }

  .not-found__orbit::before {
    position: absolute;
    top: 5%;
    right: 21%;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--ink);
    content: '';
  }

  .not-found__art > span {
    position: relative;
    z-index: 1;
    color: #fff8ee;
    font-family: var(--font-display);
    font-size: clamp(5rem, 13vw, 9rem);
    font-style: italic;
    font-weight: 500;
    letter-spacing: -0.08em;
    transform: rotate(-6deg);
  }

  .not-found__copy h1 {
    margin-top: 1.1rem;
    font-size: clamp(3rem, 7vw, 5.6rem);
    line-height: 0.98;
    letter-spacing: -0.065em;
  }

  .not-found__copy h1 span {
    color: var(--accent);
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
  }

  .not-found__copy > p:not(.eyebrow) {
    max-width: 42ch;
    margin-top: 1.3rem;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.85;
  }

  .not-found__copy .button-row {
    margin-top: 1.8rem;
  }

  @media (max-width: 800px) {
    .not-found {
      grid-template-columns: 1fr;
      gap: 2rem;
      min-height: 0;
      padding-top: 2rem;
    }

    .not-found__art {
      width: min(70vw, 300px);
      margin-inline: auto;
    }
  }
</style>
