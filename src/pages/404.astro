---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面走丢了" description="这个页面不存在。" noindex>
  <section class="not-found">
    <div class="container--text not-found__inner">
      <p class="not-found__code" aria-hidden="true">
        404
      </p>
      <p class="section-label">页面不存在</p>
      <h1>这一页不在地图上。</h1>
      <p>可能链接旧了，也可能这里从来没有过内容。回首页看看，或者直接搜索。</p>
      <div class="not-found__links">
        <a class="text-link" href="/">
          返回首页
        </a>
        <button class="text-link not-found__search" type="button" data-search-open>
          搜索站点
        </button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    min-height: 64vh;
    padding-block: 96px 120px;
    background: var(--bg-secondary);
    place-items: center;
    text-align: center;
  }

  .not-found__inner {
    display: flex;
    align-items: center;
    flex-direction: column;
  }

  .not-found__code {
    color: var(--line);
    font-family: var(--font-display);
    font-size: clamp(96px, 18vw, 180px);
    font-weight: 600;
    line-height: 0.85;
    letter-spacing: -0.06em;
  }

  .not-found .section-label {
    margin-top: 28px;
  }

  .not-found h1 {
    margin-top: 10px;
    font-size: clamp(36px, 5.2vw, 56px);
    line-height: 1.06;
    letter-spacing: -0.04em;
  }

  .not-found p:not(.not-found__code):not(.section-label) {
    max-width: 48ch;
    margin-top: 18px;
    color: var(--ink-secondary);
    font-size: 17px;
    line-height: 1.6;
  }

  .not-found__links {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 28px;
    align-items: center;
    justify-content: center;
    margin-top: 28px;
  }

  .not-found__search {
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  @media (max-width: 734px) {
    .not-found {
      min-height: 58vh;
      padding-block: 64px 80px;
    }

    .not-found__code {
      font-size: 112px;
    }
  }
</style>
