---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../lib/content';

const posts = await getPosts();
---

<BaseLayout title="文章" description="较长的思考：代码、系统设计、工具与学习方法。">
  <PageHeader
    eyebrow="文章"
    title="文章。"
    description="完整的思考需要一点时间。这里放较长的文章，关于代码、系统，也关于如何把一件事想明白。"
    meta={`${posts.length} 篇文章`}
  />

  <section class="section archive" aria-label="文章列表">
    <div class="container">
      <div class="archive-bar">
        <p>全部文章</p>
        <a class="text-link text-link--small" href="/tags/">
          按标签浏览
        </a>
      </div>

      {posts.length > 0 ? (
        <div class="archive-grid">
          {posts.map((post) => (
            <PostCard entry={post} />
          ))}
        </div>
      ) : (
        <p class="archive-empty">还没有文章。</p>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .archive {
    padding-block: 48px 96px;
  }

  .archive-bar {
    display: flex;
    gap: 20px;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--line);
    color: var(--ink-secondary);
    font-size: 12px;
    line-height: 1.4;
  }

  .archive-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 24px;
  }

  .archive-empty {
    padding: 56px 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink-secondary);
    font-size: 17px;
  }

  @media (max-width: 734px) {
    .archive {
      padding-block: 36px 64px;
    }

    .archive-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
