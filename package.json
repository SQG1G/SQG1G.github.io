{
  "name": "sqg1g-github-io",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SQG1G 的个人博客与技术笔记，基于 Astro，部署在 GitHub Pages。",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && node scripts/check-links.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "verify": "npm run build",
    "new": "node scripts/new-content.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "astro": "6.4.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "6.0.3"
  }
}
